// apps/web/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

// Modelos:
model UserProfile {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}