// apps/web/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS 
// ============================================

enum GeneroEnum {
  Masculino
  Femenino
  No_binario        @map("No binario")
  Prefiero_no_decir @map("Prefiero no decir")
}

enum NivelEducacionEnum {
  Secundario_incompleto   @map("Secundario incompleto")
  Secundario_completo     @map("Secundario completo")
  Universitario_incompleto @map("Universitario incompleto")
  Universitario_completo   @map("Universitario completo")
  Licenciatura
  Diplomatura
  Maestria                 @map("Maestría")
  Doctorado
}

enum MomentoProfesionalEnum {
  Estudio_actualmente     @map("Estudio actualmente")
  Sin_experiencia_laboral @map("Sin experiencia laboral")
  En_busqueda_activa      @map("En búsqueda activa")
  Trabajando_cambiar      @map("Trabajando (quiero cambiar)")
  Freelancer
  Emprendedor_a           @map("Emprendedor/a")
}

enum AreaInteresEnum {
  Data_Analytics          @map("Data & Analytics")
  Desarrollo_Web          @map("Desarrollo Web")
  UX_UI_Design            @map("UX / UI Design")
  Ciberseguridad
  Cloud_DevOps            @map("Cloud & DevOps")
  Inteligencia_Artificial @map("Inteligencia Artificial")
  Marketing_Digital       @map("Marketing Digital")
  Product_Management      @map("Product Management")
}

enum NivelIdiomaEnum {
  A1_Basico @map("A1 (Básico)")
  A2_Elemental @map("A2 (Elemental)")
  B1_Intermedio @map("B1 (Intermedio)")
  B2_Avanzado @map("B2 (Avanzado)")
  C1_Fluido @map("C1 (Fluido)")
}

enum DisponibilidadEnum {
  Part_time   @map("Part time")
  Full_time   @map("Full time")
  Contractor
  Freelance
}

enum UbicacionTrabajoEnum {
  Presencial
  Hibrido  @map("Híbrido")
  Remoto   @map("100% Remoto")
}

enum TipoConexionEnum {
  Banda_ancha_estable  @map("Banda ancha estable")
  Datos_moviles        @map("Datos móviles")
  Conexion_inestable   @map("Conexión inestable")
  Sin_conexion_casa    @map("Sin conexión en casa")
}

enum DispositivoEnum {
  Solo_celular @map("Solo celular")
  PC_Laptop    @map("PC / Laptop")
  Tablet
}

enum ObjetivoUsuarioEnum {
  Primer_empleo_IT      @map("Conseguir mi primer empleo IT")
  Reconversion_laboral  @map("Reconversión laboral")
  Mejorar_salario       @map("Mejorar mi salario")
  Definir_camino        @map("Definir mi camino profesional")
  Ampliar_red           @map("Ampliar mi red de contactos")
  Aprender_tecnologias  @map("Aprender nuevas tecnologías")
  Estudiar_sin_trabajar @map("Estudiar sin trabajar")
  Emprender
}

enum EstadoHabilidadEnum {
  Adquirida
  En_progreso @map("En progreso")
  Faltante
}

enum EstadoCheckinEmojiEnum {
  Agotado
  Triste
  Neutral
  Bien
  Genial
}

enum EstadoPostulacionEnum {
  Enviada
  Vista
  En_proceso @map("En proceso")
  Rechazada
  Aceptada
}

enum EstadoInscripcionEnum {
  Inscrito
  En_progreso @map("En progreso")
  Completado
  Abandonado
}

enum EstadoLeccionEnum {
  No_iniciada @map("No iniciada")
  En_progreso @map("En progreso")
  Completada
}

enum PrioridadPlanEnum {
  Alta_prioridad @map("Alta prioridad")
  Media_prioridad @map("Media prioridad")
  Baja_prioridad @map("Baja prioridad")
}

enum TipoRecursoEnum {
  Gratuito
  Pago
}

enum IdiomaAppEnum {
  es
  pt
}

enum MobilityPatternEnum {
  Baja
  Moderada
  Intensa
}

enum IncomeClusterEnum {
  A
  B
  C
  D
}

enum ModalidadVacanteEnum {
  Presencial
  Hibrido  @map("Híbrido")
  Remoto   @map("100% Remoto")
}

enum NivelVacanteEnum {
  Jr_Entry_Level @map("Jr / Entry Level")
  Semi_Senior    @map("Semi Senior")
  Senior
}

enum JornadaEnum {
  Jornada_completa      @map("Jornada completa")
  Media_jornada         @map("Media jornada")
  Relacion_dependencia  @map("Relación de dependencia")
  Freelance
}

enum OnboardingStatusEnum {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// ============================================
// TABLAS
// ============================================

model Usuarios {
  usuario_id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha_nacimiento    DateTime               @db.Date
  genero              GeneroEnum
  pais                String                 @db.VarChar(100)
  provincia_estado    String?                @db.VarChar(100)
  ciudad              String                 @db.VarChar(150)
  zona_residencia     String?                @db.VarChar(255)
  onboarding_status   OnboardingStatusEnum   @default(PENDING)
  tipo_conexion       TipoConexionEnum
  whatsapp_codigo     String?                @db.VarChar(10)
  whatsapp_numero     String?                @db.VarChar(20)
  idioma_app          IdiomaAppEnum          @default(es)
  perfil_completado   Int                    @default(0) @db.SmallInt
  lat                 Decimal?               @db.Decimal(10, 7)
  lng                 Decimal?               @db.Decimal(10, 7)
  confianza           Decimal?               @db.Decimal(3, 2)
  auth_uid            String?                @unique @db.Uuid
  email               String                 @unique @db.VarChar(255)
  nombre_completo     String                 @db.VarChar(255)
  avatar_url          String?                @db.Text
  creado_en           DateTime               @default(now()) @db.Timestamptz
  actualizado_en      DateTime               @default(now()) @db.Timestamptz
  home_cluster        String?                @db.VarChar(100)

  // Relaciones
  usuario_objetivos     UsuarioObjetivos[]
  usuario_dispositivos  UsuarioDispositivos[]
  usuario_idiomas       UsuarioIdiomas[]
  usuario_areas_interes UsuarioAreasInteres[]
  usuario_disponibilidad UsuarioDisponibilidad[]
  usuario_ubicacion_trabajo UsuarioUbicacionTrabajo[]
  usuario_nivel_educacion   UsuarioNivelEducacion[]
  usuario_momento_profesional UsuarioMomentoProfesional[]
  usuario_habilidades   UsuarioHabilidades[]
  postulaciones         Postulaciones[]
  check_ins             CheckIns[]
  respuestas_salud      RespuestasSalud[]
  orientaciones         Orientaciones[]
  inscripciones_curso   InscripcionesCurso[]
  progreso_leccion      ProgresoLeccion[]
  descargas_offline     DescargasOffline[]
  plan_accion           PlanAccion[]
  perfil_movilidad      PerfilMovilidad?
  alertas_offline       AlertasOffline[]
  notificaciones_radar  NotificacionesRadar[]

  @@map("usuarios")
  @@index([pais], map: "idx_usuarios_pais")
  @@index([ciudad], map: "idx_usuarios_ciudad")
  @@index([email], map: "idx_usuarios_email")
  @@index([home_cluster], map: "idx_usuarios_home_cluster")
  @@index([lat, lng], map: "idx_usuarios_coords") 
}

model UsuarioObjetivos {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id  String               @db.Uuid
  objetivo    ObjetivoUsuarioEnum
  creado_en   DateTime             @default(now()) @db.Timestamptz

  usuario     Usuarios             @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)

  @@unique([usuario_id, objetivo])
  @@index([usuario_id], map: "idx_uobj_usuario")
  @@map("usuario_objetivos")
}

model UsuarioDispositivos {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id  String           @db.Uuid
  dispositivo DispositivoEnum
  creado_en   DateTime         @default(now()) @db.Timestamptz

  usuario     Usuarios         @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)

  @@unique([usuario_id, dispositivo])
  @@index([usuario_id], map: "idx_udis_usuario")
  @@map("usuario_dispositivos")
}

model UsuarioIdiomas {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id  String           @db.Uuid
  idioma      String           @db.VarChar(50)
  nivel       NivelIdiomaEnum
  creado_en   DateTime         @default(now()) @db.Timestamptz

  usuario     Usuarios         @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)

  @@unique([usuario_id, idioma])
  @@index([usuario_id], map: "idx_uidi_usuario")
  @@map("usuario_idiomas")
}

model UsuarioAreasInteres {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id  String           @db.Uuid
  area        AreaInteresEnum
  creado_en   DateTime         @default(now()) @db.Timestamptz

  usuario     Usuarios         @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)

  @@unique([usuario_id, area])
  @@index([usuario_id], map: "idx_uarea_usuario")
  @@map("usuario_areas_interes")
}

model UsuarioDisponibilidad {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id      String             @db.Uuid
  disponibilidad  DisponibilidadEnum
  creado_en       DateTime           @default(now()) @db.Timestamptz

  usuario         Usuarios           @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)

  @@unique([usuario_id, disponibilidad])
  @@index([usuario_id], map: "idx_udisp_usuario")
  @@map("usuario_disponibilidad")
}

model UsuarioUbicacionTrabajo {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id  String                @db.Uuid
  ubicacion   UbicacionTrabajoEnum
  creado_en   DateTime              @default(now()) @db.Timestamptz

  usuario     Usuarios              @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)

  @@unique([usuario_id, ubicacion])
  @@index([usuario_id], map: "idx_uubic_usuario")
  @@map("usuario_ubicacion_trabajo")
}

model UsuarioNivelEducacion {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id      String              @db.Uuid
  nivel_educacion NivelEducacionEnum
  creado_en       DateTime            @default(now()) @db.Timestamptz

  usuario         Usuarios            @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)

  @@unique([usuario_id, nivel_educacion])
  @@index([usuario_id], map: "idx_uned_usuario")
  @@map("usuario_nivel_educacion")
}

model UsuarioMomentoProfesional {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id          String                  @db.Uuid
  momento_profesional MomentoProfesionalEnum
  creado_en           DateTime                @default(now()) @db.Timestamptz

  usuario             Usuarios                @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)

  @@unique([usuario_id, momento_profesional])
  @@index([usuario_id], map: "idx_umom_usuario")
  @@map("usuario_momento_profesional")
}

model HabilidadesMercado {
  habilidad_id   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String           @unique @db.VarChar(255)
  categoria      String?          @db.VarChar(100)
  area_principal AreaInteresEnum?
  creado_en      DateTime         @default(now()) @db.Timestamptz

  usuario_habilidades UsuarioHabilidades[]
  requisitos_vacante  RequisitosVacante[]
  cursos              Cursos[]          // cursos que tienen esta habilidad como principal

  @@index([nombre], map: "idx_hab_nombre")
  @@index([area_principal], map: "idx_hab_area")
  @@map("habilidades_mercado")
}

model UsuarioHabilidades {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id      String               @db.Uuid
  habilidad_id    String               @db.Uuid
  estado          EstadoHabilidadEnum  @default(Faltante)
  actualizado_en  DateTime             @default(now()) @db.Timestamptz

  usuario         Usuarios             @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)
  habilidad       HabilidadesMercado   @relation(fields: [habilidad_id], references: [habilidad_id])

  @@unique([usuario_id, habilidad_id])
  @@index([usuario_id], map: "idx_uhab_usuario")
  @@index([estado], map: "idx_uhab_estado")
  @@map("usuario_habilidades")
}

model Empresas {
  empresa_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre       String    @unique @db.VarChar(255)
  descripcion  String?   @db.Text
  sector       String?   @db.VarChar(100)
  tamanio      String?   @db.VarChar(50)
  logo_url     String?   @db.Text
  creado_en    DateTime  @default(now()) @db.Timestamptz
  cluster      String?   @db.VarChar(100)  


  vacantes     Vacantes[]

  @@index([nombre], map: "idx_empresa_nombre")
  @@map("empresas")
  @@index([cluster], map: "idx_empresas_cluster")
}

model Vacantes {
  vacante_id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id          String                @db.Uuid
  titulo              String                @db.VarChar(255)
  area                AreaInteresEnum
  nivel               NivelVacanteEnum      @default(Jr_Entry_Level)
  descripcion         String?               @db.Text
  educacion_requerida String?               @db.VarChar(255)
  experiencia_solicitada String?            @db.VarChar(255)
  jornada             JornadaEnum?
  modalidad           ModalidadVacanteEnum  @default(Hibrido)
  pais                String                @db.VarChar(100)
  ciudad              String?               @db.VarChar(150)
  detalle_modalidad   String?               @db.VarChar(255)
  distancia_zona      String?               @db.VarChar(100)
  idiomas_requeridos  Json?                 @default("[]") @db.JsonB
  activa              Boolean               @default(true)
  fecha_publicacion   DateTime              @default(dbgenerated("CURRENT_DATE")) @db.Date
  creado_en           DateTime              @default(now()) @db.Timestamptz

  empresa             Empresas              @relation(fields: [empresa_id], references: [empresa_id])
  requisitos          RequisitosVacante[]
  postulaciones       Postulaciones[]

  @@index([area], map: "idx_vac_area")
  @@index([pais], map: "idx_vac_pais")
  @@index([activa], map: "idx_vac_activa")
  @@index([empresa_id], map: "idx_vac_empresa")
  @@map("vacantes")
}

model RequisitosVacante {
  requisito_id String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vacante_id   String          @db.Uuid
  habilidad_id String          @db.Uuid
  prioridad    Int             @default(1) @db.SmallInt
  creado_en    DateTime        @default(now()) @db.Timestamptz

  vacante      Vacantes        @relation(fields: [vacante_id], references: [vacante_id], onDelete: Cascade)
  habilidad    HabilidadesMercado @relation(fields: [habilidad_id], references: [habilidad_id])

  @@index([vacante_id], map: "idx_req_vacante")
  @@index([habilidad_id], map: "idx_req_habilidad")
  @@map("requisitos_vacante")
}

model Postulaciones {
  postulacion_id     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id         String               @db.Uuid
  vacante_id         String               @db.Uuid
  mensaje_motivacion String?              @db.Text
  usar_cv_guardado   Boolean              @default(true)
  cv_url             String?              @db.Text
  match_porcentaje   Decimal?             @db.Decimal(5, 2)
  estado             EstadoPostulacionEnum @default(Enviada)
  creado_en          DateTime             @default(now()) @db.Timestamptz
  actualizado_en     DateTime             @default(now()) @db.Timestamptz

  usuario            Usuarios             @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)
  vacante            Vacantes             @relation(fields: [vacante_id], references: [vacante_id])

  @@unique([usuario_id, vacante_id])
  @@index([usuario_id], map: "idx_post_usuario")
  @@index([vacante_id], map: "idx_post_vacante")
  @@index([estado], map: "idx_post_estado")
  @@map("postulaciones")
}

model CheckIns {
  checkin_id   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id   String                  @db.Uuid
  emoji        EstadoCheckinEmojiEnum
  nota_diaria  Decimal                 @db.Decimal(4, 2)
  creado_en    DateTime                @default(now()) @db.Timestamptz

  usuario      Usuarios                @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)
  motivos      CheckInMotivos[]
  contextos    CheckInContexto[]
  respuestas_salud RespuestasSalud[]

  @@index([usuario_id], map: "idx_chk_usuario")
  @@index([creado_en], map: "idx_chk_fecha")
  @@index([nota_diaria], map: "idx_chk_nota")
  @@map("check_ins") 
}

model CheckInMotivos {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkin_id  String    @db.Uuid
  motivo      String    @db.VarChar(255)
  creado_en   DateTime  @default(now()) @db.Timestamptz

  checkin     CheckIns  @relation(fields: [checkin_id], references: [checkin_id], onDelete: Cascade)

  @@index([checkin_id], map: "idx_chkmot_checkin")
  @@map("check_in_motivos")
}

model CheckInContexto {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkin_id  String    @db.Uuid
  contexto    String    @db.Text
  creado_en   DateTime  @default(now()) @db.Timestamptz

  checkin     CheckIns  @relation(fields: [checkin_id], references: [checkin_id], onDelete: Cascade)

  @@index([checkin_id], map: "idx_chkctx_checkin")
  @@map("check_in_contexto")
}

model RespuestasSalud {
  respuesta_id  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id    String    @db.Uuid
  checkin_id    String?   @db.Uuid
  nota_semanal  Decimal   @db.Decimal(4, 2)
  nota_actual   Decimal   @db.Decimal(4, 2)
  mensaje       String    @db.Text
  accion_sugerida String  @db.Text
  derivar_cvv   Boolean   @default(false)
  alerta        Boolean   @default(false)
  creado_en     DateTime  @default(now()) @db.Timestamptz

  usuario       Usuarios  @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)
  checkin       CheckIns? @relation(fields: [checkin_id], references: [checkin_id])

  @@index([usuario_id], map: "idx_rsalud_usuario")
  @@index([derivar_cvv], map: "idx_rsalud_cvv")
  @@index([creado_en], map: "idx_rsalud_fecha")
  @@map("respuestas_salud")
}

model Orientaciones {
  orientacion_id      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id          String        @db.Uuid
  gap_porcentual      Decimal       @db.Decimal(5, 2)
  gap_items           Json          @default("[]") @db.JsonB
  trayectoria_sugerida Json         @default("[]") @db.JsonB
  vacantes_compatibles Json         @default("[]") @db.JsonB
  confianza           Decimal       @db.Decimal(3, 2)
  idioma_respuesta    IdiomaAppEnum @default(es)
  creado_en           DateTime      @default(now()) @db.Timestamptz

  usuario             Usuarios      @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)

  @@index([usuario_id], map: "idx_orient_usuario")
  @@index([creado_en], map: "idx_orient_fecha")
  @@map("orientaciones")
}

model Cursos {
  curso_id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo                String          @db.VarChar(255)
  subtitulo             String?         @db.VarChar(255)
  descripcion           String?         @db.Text
  area                  AreaInteresEnum
  tipo                  TipoRecursoEnum @default(Gratuito)
  plataforma            String?         @db.VarChar(255)
  url_externa           String?         @db.Text
  duracion_estimada_dias Int?
  imagen_portada_url    String?         @db.Text
  habilidad_principal   String?         @db.Uuid  // FK a HabilidadesMercado
  activo                Boolean         @default(true)
  creado_en             DateTime        @default(now()) @db.Timestamptz

  habilidad             HabilidadesMercado? @relation(fields: [habilidad_principal], references: [habilidad_id])
  modulos               Modulos[]
  inscripciones         InscripcionesCurso[]
  plan_accion           PlanAccion[]
  alertas_offline       AlertasOffline[]
  recursos_descarga     RecursosDescarga[]

  @@index([area], map: "idx_curso_area")
  @@index([activo], map: "idx_curso_activo")
  @@map("cursos")
}

model Modulos {
  modulo_id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  curso_id        String    @db.Uuid
  titulo          String    @db.VarChar(255)
  orden           Int       @db.SmallInt
  total_lecciones Int       @default(0) @db.SmallInt
  creado_en       DateTime  @default(now()) @db.Timestamptz

  curso           Cursos    @relation(fields: [curso_id], references: [curso_id], onDelete: Cascade)
  lecciones       Lecciones[]

  @@index([curso_id], map: "idx_mod_curso")
  @@map("modulos")
}

model Lecciones {
  leccion_id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modulo_id        String    @db.Uuid
  titulo           String    @db.VarChar(255)
  orden            Int       @db.SmallInt
  tipo             String?   @default("Video") @db.VarChar(50)
  duracion_minutos Decimal?  @db.Decimal(6, 2)
  video_url        String?   @db.Text
  creado_en        DateTime  @default(now()) @db.Timestamptz

  modulo           Modulos   @relation(fields: [modulo_id], references: [modulo_id], onDelete: Cascade)
  progreso         ProgresoLeccion[]

  @@index([modulo_id], map: "idx_lec_modulo")
  @@map("lecciones")
}

model InscripcionesCurso {
  inscripcion_id      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id          String             @db.Uuid
  curso_id            String             @db.Uuid
  estado              EstadoInscripcionEnum @default(Inscrito)
  progreso_porcentaje Int                @default(0) @db.SmallInt
  fecha_inicio        DateTime           @default(now()) @db.Timestamptz
  fecha_completado    DateTime?          @db.Timestamptz
  creado_en           DateTime           @default(now()) @db.Timestamptz

  usuario             Usuarios           @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)
  curso               Cursos             @relation(fields: [curso_id], references: [curso_id])

  @@unique([usuario_id, curso_id])
  @@index([usuario_id], map: "idx_insc_usuario")
  @@index([curso_id], map: "idx_insc_curso")
  @@index([estado], map: "idx_insc_estado")
  @@map("inscripciones_curso")
}

