{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "test:b2b": "tsx --test src/features/empleabilidad/server/b2b-jobs.client.test.ts src/features/empleabilidad/server/match-policy.test.ts src/features/empleabilidad/server/mobility.test.ts",
    "test:profile": "tsx --test src/features/profile/profile-completion.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed-demo": "tsx prisma/seed-test.ts",
    "db:verify-mobility": "tsx prisma/verify-mobility-data.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:check-migration-status": "prisma migrate status",
    "test:progress": "tsx --test src/server/progress/skill-progress.test.ts src/features/dashboard/server/progress-history.test.ts",
    "build": "pnpm --filter @appbit/shared-types build && pnpm --filter @appbit/shared-schemas build && prisma generate && next build"
  },
  "dependencies": {
    "@appbit/shared-schemas": "workspace:*",
    "@appbit/shared-types": "workspace:*",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/client-runtime-utils": "7.8.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "next-intl": "^4.13.0",
    "pg": "^8.21.0",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
